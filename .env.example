# Copy to .env (gitignored) and fill in. The backend loads .env on start;
# variables already set in the process environment take precedence.
# No model/API call is made unless HABITATFIRE_ENABLE_AI=1 and the keys are set.
HABITATFIRE_ENABLE_AI=0

# Generation: Claude (Anthropic API)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Embeddings: Voyage AI via MongoDB Atlas "AI Model APIs" key
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4

# Vector store: MongoDB Atlas (Atlas Vector Search)
MONGODB_URI=
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DB=habitatfire

# Optional local runtime settings (defaults shown):
HOST=127.0.0.1
PORT=8000
HABITATFIRE_API_PORT=8000
HABITATFIRE_WEB_PORT=5173
# HABITATFIRE_PYTHON=C:/path/to/python.exe
