{
  "name": "habitatfire",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:full": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "api": "node scripts/dev.mjs --api-only",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "data:sync": "python scripts/sync_nasa.py",
    "data:offline": "python scripts/sync_nasa.py --offline",
    "data:check": "python -m unittest discover -s scripts -p test_sync_nasa.py",
    "research:corpus": "python scripts/build_research_corpus.py",
    "media:index": "python scripts/build_media_index.py",
    "research:check": "python -m unittest discover -s backend -p test_*.py",
    "targets:build": "python scripts/build_modeling_targets.py",
    "sim:check": "node --test scripts/test_habitat_engine.mjs scripts/test_saffire_bidirectional.mjs scripts/test_saffire_ii5.mjs scripts/test_saffire_ii_all.mjs scripts/test_saffire_ii_board.mjs scripts/test_saffire_iii.mjs scripts/test_saffire_published.mjs scripts/test_specialist_frontend.mjs scripts/test_english_frontend.mjs scripts/test_dashboard.mjs scripts/test_experimental_replays.mjs scripts/test_habitat_pieces.mjs scripts/test_origin_panel.mjs scripts/test_origin_equivalence.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.3"
  }
}
